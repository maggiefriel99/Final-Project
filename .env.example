# Copy this file to .env (in this folder or the folder above it) and fill in your own key.
# Never commit .env or share a real key.

# Portkey API gateway, used for every AI call. Every agent uses gpt-6-luna; no other model.
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional. Only used by "Refresh from NYC Open Data"; raises NYC Open Data rate limits.
# Free at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Optional. Only used by prepare_data.py to refresh median household income (Census ACS).
# The app itself never needs it: the income data ships in data/district_income.csv.
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional log protection (civicequity/logstore.py). Without these the app works as is.
# Encrypt every new log record with this Fernet key. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: encrypted logs can't be read without it.
CIVICEQUITY_LOG_KEY=
# Delete log records older than this many days when the app starts (open alerts are always kept).
CIVICEQUITY_LOG_RETENTION_DAYS=180

# Optional per-sender limits: requests past these are held for a person without using AI.
CIVICEQUITY_SENDER_LIMIT_PER_HOUR=20
CIVICEQUITY_SENDER_LIMIT_PER_DAY=60
# Salt for the sender hash (only a hash of each sender id is stored). Change it for real use.
CIVICEQUITY_SENDER_SALT=
